{
  "name": "mildly-journaling",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "wrangler pages dev build",
    "dev:comments": "npm run build && node scripts/dev-comments.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:existing": "npm --prefix tests test -- --runInBand",
    "test:browser": "node test/browser.mjs",
    "check:deploy": "node scripts/check-comments-config.mjs",
    "comments:export": "node scripts/export-remark42.mjs",
    "maintenance:deploy": "wrangler deploy --config maintenance/wrangler.toml"
  },
  "dependencies": {
    "jose": "6.2.15"
  },
  "overrides": {
    "miniflare@4.20260730.0": {
      "undici": "7.30.1",
      "sharp": "0.35.5"
    }
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "playwright": "1.64.1",
    "wrangler": "4.157.0"
  }
}
